FROM node:24.21.0-slim

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 3000

CMD npx prisma generate && npx prisma migrate deploy && npx prisma db execute --file prisma/seed/dev.sql && exec npm run start:dev