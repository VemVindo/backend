generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id_empresa    Int      @id @default(autoincrement())
  nome_fantasia String
  email         String   @unique
  telefone      String
  CNPJ          String?  @unique
  cpf           String?  @unique
  cep           String
  logradouro    String
  numero        Int
  complemento   String?
  bairro        String
  cidade        String
  UF            String
  razao_social  String?
  senha         String
  sessao_versao Int      @default(0)

  pedidos  Pedido[]
  metricas MetricasPagamento[]
  contratos Contrato[]
  credenciais CredencialIntegracao[]
}

model Entregador {
  cpf              String  @id
  nome             String
  disponivel       Boolean @default(true)
  telefone         String
  tipo_veiculo     String
  placa            String?
  senha            String
  senha_temporaria Boolean @default(true)
  ciencia_dados_em DateTime?
  senha_temporaria_expira_em DateTime?
  sessao_versao    Int     @default(0)

  pedidos Pedido[]
  contratos Contrato[]

  historicosAntigos HistoricoPedidoEntregadores[] @relation("EntregadorAntigo")
  historicosNovos   HistoricoPedidoEntregadores[] @relation("EntregadorNovo")
}

model Pedido {
  id_pedido           Int       @id @default(autoincrement())
  nome_recebedor      String
  telefone_recebedor  String
  cep                 String
  logradouro          String
  numero              Int
  complemento         String?
  bairro              String
  cidade              String
  uf                  String
  descricao           String
  status              String
  data_criacao        DateTime
  data_inicio_entrega DateTime?
  data_finalizacao    DateTime?
  valor_entrega       Int
  idEmpresa           Int
  cpf_entregador      String?
  distancia           Int

  empresa    Empresa     @relation(fields: [idEmpresa], references: [id_empresa])
  entregador Entregador? @relation(fields: [cpf_entregador], references: [cpf])

  avaliacao  Avaliacao?
  historicos HistoricoPedidoEntregadores[]
}

model MetricasPagamento {
  idEmpresa    Int
  taxa_fixa    Int
  coeficiente  Int
  data         DateTime

  empresa Empresa @relation(fields: [idEmpresa], references: [id_empresa])

  @@id([idEmpresa, data])
}

model Avaliacao {
  idpedidos         Int    @id
  avaliacao_entrega Int
  comentario        String

  pedido Pedido @relation(fields: [idpedidos], references: [id_pedido])
}

model HistoricoPedidoEntregadores {
  id_historico          Int      @id @default(autoincrement())
  id_pedido             Int
  cpf_entregador_antigo String
  cpf_entregador_novo   String
  data                  DateTime

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido])

  entregadorAntigo Entregador @relation("EntregadorAntigo", fields: [cpf_entregador_antigo], references: [cpf])
  entregadorNovo   Entregador @relation("EntregadorNovo", fields: [cpf_entregador_novo], references: [cpf])
}

// RECUSADO e ENCERRADO preenchem data_fim; o indice parcial abaixo depende disso.
enum StatusContrato {
  PENDENTE
  ATIVO
  RECUSADO
  ENCERRADO
}

model Contrato {
  id_contrato    Int            @id @default(autoincrement())
  idEmpresa      Int
  cpf_entregador String
  status         StatusContrato @default(PENDENTE)
  data_inicio    DateTime
  data_aceite    DateTime?
  data_fim       DateTime?

  empresa    Empresa    @relation(fields: [idEmpresa], references: [id_empresa])
  entregador Entregador @relation(fields: [cpf_entregador], references: [cpf])

  @@unique([idEmpresa, cpf_entregador], where: { data_fim: null }, map: "Contrato_vinculo_ativo_key")
}

model CredencialIntegracao {
  id_credencial  Int       @id @default(autoincrement())
  idEmpresa      Int
  prefixo        String    @unique
  hash           String
  data_criacao   DateTime  @default(now())
  data_revogacao DateTime?
  ultimo_uso     DateTime?

  empresa Empresa @relation(fields: [idEmpresa], references: [id_empresa])

  @@unique([idEmpresa], where: { data_revogacao: null }, map: "CredencialIntegracao_ativa_key")
}
