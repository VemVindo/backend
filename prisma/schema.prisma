generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id_empresa             Int      @id @default(autoincrement())
  nome_fantasia          String
  email                  String   @unique
  telefone               String
  CNPJ                   String?  @unique
  cpf                    String?  @unique
  cep                    String
  logradouro             String
  numero                 Int
  complemento            String?
  bairro                 String
  cidade                 String
  UF                     String
  razao_social           String?
  senha                  String
  sessao_versao          Int      @default(0)
  // Falso: o recebedor ve so distancia e tempo estimado, sem o mapa (R-US03).
  exibir_mapa            Boolean  @default(true)
  // Coordenada do endereco da empresa: ponto de saida no mapa da entrega.
  origem_lat             Float?
  origem_lng             Float?
  // E-US02: a ultima atualizacao conta so a edicao do cadastro (E-US03), nao
  // a troca de sessao nem as configuracoes.
  criada_em              DateTime @default(now())
  cadastro_atualizado_em DateTime @default(now())

  pedidos     Pedido[]
  metricas    MetricasPagamento[]
  contratos   Contrato[]
  credenciais CredencialIntegracao[]
  importacoes PedidoImportado[]
}

model Entregador {
  cpf                        String    @id
  nome                       String
  disponivel                 Boolean   @default(true)
  telefone                   String
  tipo_veiculo               String
  placa                      String?
  senha                      String
  senha_temporaria           Boolean   @default(true)
  ciencia_dados_em           DateTime? @db.Timestamptz(3)
  senha_temporaria_expira_em DateTime? @db.Timestamptz(3)
  sessao_versao              Int       @default(0)

  pedidos   Pedido[]
  contratos Contrato[]

  historicosAntigos HistoricoPedidoEntregadores[] @relation("EntregadorAntigo")
  historicosNovos   HistoricoPedidoEntregadores[] @relation("EntregadorNovo")
}

model Pedido {
  id_pedido                          Int          @id @default(autoincrement())
  nome_recebedor                     String
  telefone_recebedor                 String
  cep                                String
  logradouro                         String
  numero                             Int
  complemento                        String?
  bairro                             String
  cidade                             String
  uf                                 String
  descricao                          String
  status                             StatusPedido @default(PENDENTE)
  data_criacao                       DateTime     @db.Timestamptz(3)
  data_inicio_entrega                DateTime?    @db.Timestamptz(3)
  data_finalizacao                   DateTime?    @db.Timestamptz(3)
  valor_entrega                      Int

  ganho_consolidado_centavos         Int?
  taxa_fixa_atribuicao_centavos      Int?
  coeficiente_atribuicao_centavos_km Int?
  parametros_vigentes_desde          DateTime?    @db.Timestamptz(3)
  remuneracao_atribuida_em           DateTime?    @db.Timestamptz(3)

  distancia_conhecida                Boolean?
  idEmpresa                          Int
  cpf_entregador                     String?
  distancia                          Int
  // Coordenada do endereco, geocodificada uma vez e reaproveitada.
  destino_lat                        Float?
  destino_lng                        Float?

  empresa    Empresa     @relation(fields: [idEmpresa], references: [id_empresa])
  // Igual a FK da migration: entregador com pedido nao pode ser apagado.
  entregador Entregador? @relation(fields: [cpf_entregador], references: [cpf], onDelete: Restrict)

  avaliacao          Avaliacao?
  historicos         HistoricoPedidoEntregadores[]
  importacao         PedidoImportado?
  acessoRecebedor    AcessoRecebedor?
  localizacao        LocalizacaoEntrega?
}

model MetricasPagamento {
  idEmpresa   Int
  taxa_fixa   Int
  coeficiente Int
  data        DateTime @db.Timestamptz(3)

  empresa Empresa @relation(fields: [idEmpresa], references: [id_empresa])

  @@id([idEmpresa, data])
}

// R-US05: nota de 0 a 5. R-US06: o comentario e opcional e chega depois
// da nota. A data ordena e filtra a pagina de comentarios (E-US17).
model Avaliacao {
  idpedidos         Int      @id
  avaliacao_entrega Int
  comentario        String?
  data              DateTime @default(now())

  pedido Pedido @relation(fields: [idpedidos], references: [id_pedido])

  @@index([data])
}

// cpf_entregador_antigo nulo indica a primeira atribuicao de um pedido PENDENTE.
model HistoricoPedidoEntregadores {
  id_historico          Int      @id @default(autoincrement())
  id_pedido             Int
  cpf_entregador_antigo String?
  cpf_entregador_novo   String
  data                  DateTime @db.Timestamptz(3)

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido])

  entregadorAntigo Entregador? @relation("EntregadorAntigo", fields: [cpf_entregador_antigo], references: [cpf], onDelete: Restrict)
  entregadorNovo   Entregador  @relation("EntregadorNovo", fields: [cpf_entregador_novo], references: [cpf])

  @@index([id_pedido])
}

// PENDENTE e o unico status sem entregador; atribuir um entregador leva a EM_ANDAMENTO.
enum StatusPedido {
  PENDENTE
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

// RECUSADO e ENCERRADO preenchem data_fim; o indice parcial abaixo depende disso.
enum StatusContrato {
  PENDENTE
  ATIVO
  RECUSADO
  ENCERRADO
}

model Contrato {
  id_contrato    Int            @id @default(autoincrement())
  idEmpresa      Int
  cpf_entregador String
  status         StatusContrato @default(PENDENTE)
  data_inicio    DateTime       @db.Timestamptz(3)
  data_aceite    DateTime?      @db.Timestamptz(3)
  data_fim       DateTime?      @db.Timestamptz(3)

  empresa    Empresa    @relation(fields: [idEmpresa], references: [id_empresa])
  entregador Entregador @relation(fields: [cpf_entregador], references: [cpf])

  @@unique([idEmpresa, cpf_entregador], where: { data_fim: null }, map: "Contrato_vinculo_ativo_key")
}

model AcessoRecebedor {
  idPedido                Int       @id
  token_hash              String    @unique
  codigo_recebedor        String
  data_criacao            DateTime  @default(now()) @db.Timestamptz(3)
  tentativas_codigo       Int       @default(0)
  ultima_tentativa_codigo DateTime?

  pedido Pedido @relation(fields: [idPedido], references: [id_pedido])
}

// So a ultima posicao do entregador na entrega em andamento: a linha e apagada
// quando o pedido e encerrado ou troca de entregador.
model LocalizacaoEntrega {
  idPedido             Int       @id
  lat                  Float
  lng                  Float
  precisao_m           Float?
  registrada_em        DateTime  @db.Timestamptz(3)
  // Ponto de onde a rota atual foi calculada.
  origem_rota_lat      Float?
  origem_rota_lng      Float?
  rota_polyline        String?
  distancia_restante_m Int?
  duracao_restante_s   Int?
  estimado             Boolean   @default(true)
  rota_calculada_em    DateTime? @db.Timestamptz(3)

  pedido Pedido @relation(fields: [idPedido], references: [id_pedido], onDelete: Cascade)
}

model CredencialIntegracao {
  id_credencial  Int       @id @default(autoincrement())
  idEmpresa      Int
  prefixo        String    @unique
  hash           String
  data_criacao   DateTime  @default(now()) @db.Timestamptz(3)
  data_revogacao DateTime? @db.Timestamptz(3)
  ultimo_uso     DateTime? @db.Timestamptz(3)

  empresa Empresa @relation(fields: [idEmpresa], references: [id_empresa])

  @@unique([idEmpresa], where: { data_revogacao: null }, map: "CredencialIntegracao_ativa_key")
}

enum SituacaoImportacao {
  AGUARDANDO_COMPLETUDE
  CONVERTIDO
}

model PedidoImportado {
  id_importacao    Int                @id @default(autoincrement())
  idEmpresa        Int
  id_externo       String
  dados            Json
  campos_faltantes String[]
  situacao         SituacaoImportacao @default(AGUARDANDO_COMPLETUDE)
  idPedido         Int?               @unique
  data_recebimento DateTime           @default(now()) @db.Timestamptz(3)

  empresa Empresa @relation(fields: [idEmpresa], references: [id_empresa])
  pedido  Pedido? @relation(fields: [idPedido], references: [id_pedido])

  @@unique([idEmpresa, id_externo])
}
