# Conexao Postgres do Supabase
# Supabase > Connect > Session pooler (URI).
# Use o SESSION pooler (porta 5432): funciona em IPv4 e suporta o TypeORM/synchronize.
# NAO use a conexao direta (db.<ref>.supabase.co): e somente IPv6.
# O Transaction pooler (porta 6543) e para serverless, nao para servidor persistente.
DATABASE_URL=postgresql://postgres.dccavdthglxqdftpymty:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# SSL e obrigatorio no Supabase. Deixe true (padrao).
# Use false apenas em um Postgres local sem SSL.
DB_SSL=true

# Cria/atualiza as tabelas a partir das entidades no boot.
# Use true apenas em desenvolvimento; em producao use migrations.
DB_SYNCHRONIZE=true

# Segredo para assinar os tokens JWT. Gere um valor forte e unico.
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1d

PORT=3000
