# Variaveis para rodar fora do compose de dev (ex.: producao no Supabase).
# Copie para .env e preencha. Nunca versione o .env.

# Conexao de runtime da aplicacao. No Supabase: Connect > Session pooler (URI).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Conexao direta usada pelo Prisma (generate e migrations).
DIRECT_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Segredo do JWT (HS256), minimo de 32 caracteres. Gere com:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Origem do frontend liberada no CORS (o cookie de sessao depende dela).
CORS_ORIGIN=http://localhost:3000

# Endereco publico do frontend, usado para montar o link de rastreio do
# recebedor. Sem ele, vale o CORS_ORIGIN.
URL_FRONTEND=http://localhost:3000

PORT=3000

# Quantos proxies reversos ficam na frente da API (ex.: 1 no Render/Railway).
# Necessario para o limite de tentativas de login enxergar o IP real.
TRUST_PROXY=1
